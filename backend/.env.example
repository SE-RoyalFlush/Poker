# Environment (development or production)
APP_ENV=development
GO_ENV=development

# Server
PORT=8080

# CSRF Protection (32-byte key for production)
CSRF_AUTH_KEY=dev-only-32-byte-csrf-secret-key

# JWT Token Signing (change in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Frontend URL (for CORS in production)
# Development: defaults to http://localhost:4200
# Production: set to your Vercel frontend URL
FRONTEND_URL=http://localhost:4200
