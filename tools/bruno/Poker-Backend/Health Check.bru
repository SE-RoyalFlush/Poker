meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{base_url}}/health
  body: none
  auth: inherit
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });
  
  test("body.status is alive", function () {
    expect(res.body.status).to.equal("alive");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
