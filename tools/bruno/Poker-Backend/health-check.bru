meta {
  name: health-check
  type: http
  seq: 1
}

get {
  url: {{base_url}}/health
  body: none
  auth: inherit
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });
  
  test("body.status is alive", function () {
    expect(res.body.status).to.equal("alive");
    expect(["connected", "disconnected"]).to.include(res.body.database);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
