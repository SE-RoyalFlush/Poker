{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/poker-frontend/browser",
  "framework": "angular",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://poker-csxs.onrender.com/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
